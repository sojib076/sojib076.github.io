# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"

# Database name inside that cluster.
MONGODB_DB="shibu_store"

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public URL of the site. Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seeding (only read by `npm run db:seed`)
# ---------------------------------------------------------------------------

ADMIN_EMAIL="owner@example.com"
# No owner account is created unless this is set.
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Optional — which store this deployment serves
# ---------------------------------------------------------------------------

# Only needed when the database holds more than one store.
# ACTIVE_STORE_SLUG="shibu-store"

# ---------------------------------------------------------------------------
# Optional — SMS / WhatsApp notifications
# ---------------------------------------------------------------------------

# With no gateway configured, messages (including sign-in codes) are logged to
# the server console, so the whole flow works in development.
# SMS_GATEWAY_URL="https://api.your-sms-vendor.com/send"
# SMS_GATEWAY_TOKEN=""
# SMS_GATEWAY_SENDER="ShibuStore"

# ---------------------------------------------------------------------------
# Optional — object storage for product photos
# ---------------------------------------------------------------------------

# Without these, uploads are written to public/uploads on the local disk.
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces or MinIO.
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_BUCKET="shibu-store"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_PUBLIC_URL="https://images.example.com"

# Hostname of the image CDN, so next/image is allowed to optimise from it.
# NEXT_PUBLIC_IMAGE_HOST="images.example.com"
